<fragment>
    <!-- HiddenLayer OAuth Token Management -->
    <set-variable name="hl_skip_models" value='@(context.Request.Method.Equals("GET", StringComparison.OrdinalIgnoreCase) &amp;&amp; context.Request.Url.Path != null &amp;&amp; context.Request.Url.Path.EndsWith("/v1/models", StringComparison.OrdinalIgnoreCase))' />
    <choose>
        <when condition='@((bool)context.Variables["hl_skip_models"])'>
            <set-variable name="hl_oauth_status_code" value='@("skipped")' />
            <set-variable name="hl_oauth_error" value='@("")' />
            <set-variable name="hl_access_token_len" value='@(0)' />
            <set-variable name="access_token" value='@("")' />
        </when>
        <otherwise>
            <cache-lookup-value key="aad-ccg-token" variable-name="ccg_token" />
            <set-variable name="hl_oauth_status_code" value='@("cached")' />
            <set-variable name="hl_oauth_error" value='@("")' />
            <set-variable name="hl_access_token_len" value='@(0)' />
            <set-variable name="hl_client_id" value="{{hl-client-id}}" />
            <set-variable name="hl_client_secret" value="{{hl-client-secret}}" />
            <choose>
                <when condition='@(string.IsNullOrEmpty((string)context.Variables.GetValueOrDefault("ccg_token","")))'>
                    <send-request mode="new" response-variable-name="token_resp" timeout="10" ignore-error="true">
                        <set-url>https://auth.{{hl-host}}/oauth2/token</set-url>
                        <set-method>POST</set-method>
                        <set-header name="Content-Type" exists-action="override">
                            <value>application/x-www-form-urlencoded</value>
                        </set-header>
                        <set-body><![CDATA[@{
                            string enc(string s) => System.Net.WebUtility.UrlEncode(s);
                            var clientId = context.Variables.GetValueOrDefault<string>("hl_client_id", "");
                            var secret = context.Variables.GetValueOrDefault<string>("hl_client_secret", "");
                            return $"grant_type=client_credentials&client_id={enc(clientId)}&client_secret={enc(secret)}";
                        }]]></set-body>
                    </send-request>
                    <choose>
                        <when condition='@(context.Variables.ContainsKey("token_resp") &amp;&amp; context.Variables["token_resp"] != null &amp;&amp; ((IResponse)context.Variables["token_resp"]).StatusCode >= 200 &amp;&amp; ((IResponse)context.Variables["token_resp"]).StatusCode &lt; 300)'>
                            <set-variable name="hl_oauth_status_code" value='@(((IResponse)context.Variables["token_resp"]).StatusCode.ToString())' />
                            <set-variable name="token_json" value='@(((IResponse)context.Variables["token_resp"]).Body.As&lt;JObject&gt;())' />
                            <set-variable name="access_token" value='@((string)((JObject)context.Variables["token_json"])["access_token"] ?? "")' />
                            <set-variable name="expires_in" value='@((int?)((JObject)context.Variables["token_json"])["expires_in"] ?? 3600)' />
                            <choose>
                                <when condition='@(!string.IsNullOrEmpty((string)context.Variables["access_token"]))'>
                                    <set-variable name="hl_access_token_len" value='@(((string)context.Variables["access_token"]).Length)' />
                                    <cache-store-value key="aad-ccg-token" value='@((string)context.Variables["access_token"])' duration="{{hl-oauth-cache-seconds}}" />
                                </when>
                                <otherwise>
                                    <set-variable name="access_token" value='@((string)context.Variables.GetValueOrDefault("ccg_token", ""))' />
                                    <set-variable name="hl_access_token_len" value='@(((string)context.Variables["access_token"]).Length)' />
                                </otherwise>
                            </choose>
                        </when>
                        <otherwise>
                            <set-variable name="hl_oauth_status_code" value='@(context.Variables.ContainsKey("token_resp") &amp;&amp; context.Variables["token_resp"] != null ? ((IResponse)context.Variables["token_resp"]).StatusCode.ToString() : "null")' />
                            <set-variable name="access_token" value='@((string)context.Variables.GetValueOrDefault("ccg_token", ""))' />
                            <set-variable name="hl_access_token_len" value='@(((string)context.Variables["access_token"]).Length)' />
                        </otherwise>
                    </choose>
                </when>
                <otherwise>
                    <set-variable name="access_token" value='@((string)context.Variables.GetValueOrDefault("ccg_token", ""))' />
                    <set-variable name="hl_access_token_len" value='@(((string)context.Variables["access_token"]).Length)' />
                </otherwise>
            </choose>
        </otherwise>
    </choose>
</fragment>
