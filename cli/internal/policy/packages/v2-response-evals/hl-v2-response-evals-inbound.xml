<fragment>
    <!-- HiddenLayer v2 Response Evaluations – Inbound Setup -->
    <set-variable name="hl_runtime_action" value='@("")' />
    <set-variable name="hl_original_body" value="@(context.Request.Body.As&lt;string&gt;(preserveContent: true))" />
    <set-variable name="hl_roundtrip_id" value='@{
        var existing = (string)context.Variables.GetValueOrDefault("hl_roundtrip_id", "");
        return !string.IsNullOrEmpty(existing) ? existing : context.Request.Headers.GetValueOrDefault("HL-Roundtrip-Id", Guid.NewGuid().ToString());
    }' />
    <set-variable name="hl_runtime_edge_provider" value='@(context.Request.Headers.GetValueOrDefault("HL-Runtime-Edge-Provider", "azure-apim"))' />
    <set-variable name="hl_runtime_session_id" value='@(context.Request.Headers.GetValueOrDefault("HL-Runtime-Session-Id", ""))' />
    <set-variable name="hl_requester_id" value='@(context.Request.Headers.GetValueOrDefault("HL-Requester-Id", ""))' />
    <set-variable name="hl_provider_id" value='@(context.Request.Headers.GetValueOrDefault("HL-Provider-Id", ""))' />
    <set-header name="HL-Model" exists-action="delete" />
    <set-header name="HL-Runtime-Edge-Provider" exists-action="delete" />
    <set-header name="HL-Requester-Id" exists-action="delete" />
    <set-header name="HL-Provider-Id" exists-action="delete" />
    <set-header name="HL-Runtime-Session-Id" exists-action="delete" />
    <set-header name="Accept-Encoding" exists-action="override">
        <value>identity</value>
    </set-header>
</fragment>
