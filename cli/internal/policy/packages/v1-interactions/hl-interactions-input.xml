<fragment>
    <!-- HiddenLayer v1 Interactions – Input Evaluation -->
    <set-variable name="hl_project_id" value="{{hl-project-id}}" />
    <set-variable name="hl_skip_models" value='@(context.Request.Method.Equals("GET", StringComparison.OrdinalIgnoreCase) &amp;&amp; context.Request.Url.Path != null &amp;&amp; context.Request.Url.Path.EndsWith("/v1/models", StringComparison.OrdinalIgnoreCase))' />
    <choose>
        <when condition='@((bool)context.Variables["hl_skip_models"])'>
            <!-- Skip HiddenLayer scanning for model discovery requests -->
            <set-variable name="hl_runtime_action" value='@("")' />
            <set-variable name="hl_threat_level" value='@("")' />
            <set-header name="HL-Model" exists-action="delete" />
            <set-header name="HL-Provider" exists-action="delete" />
            <set-header name="HL-Requester-Id" exists-action="delete" />
            <set-header name="Accept-Encoding" exists-action="override">
                <value>identity</value>
            </set-header>
        </when>
        <otherwise>
            <set-variable name="hl_input_start" value="@(DateTime.UtcNow)" />
            <set-variable name="hl_original_body" value="@(context.Request.Body.As&lt;string&gt;(preserveContent: true))" />
            <set-variable name="hl_runtime_action" value='@("")' />
            <set-variable name="hl_threat_level" value='@("")' />
            <!-- Read metadata from headers and store as context variables for OutputFragment reuse -->
            <set-variable name="hl_model" value='@(context.Request.Headers.GetValueOrDefault("HL-Model", ""))' />
            <set-variable name="hl_provider" value='@(context.Request.Headers.GetValueOrDefault("HL-Provider", "azure-apim"))' />
            <set-variable name="hl_requester_id" value='@(context.Request.Headers.GetValueOrDefault("HL-Requester-Id", context.Subscription?.Key ?? context.Request.IpAddress ?? "unknown"))' />
            <!-- If no HL-Model header, extract model from request body -->
            <choose>
                <when condition='@(string.IsNullOrEmpty((string)context.Variables["hl_model"]))'>
                    <set-variable name="hl_model" value='@((string)(JObject.Parse((string)context.Variables["hl_original_body"])["model"] ?? ""))' />
                </when>
            </choose>
            <send-request mode="new" response-variable-name="hl_eval_response" timeout="30" ignore-error="true">
                <set-url>https://api.{{hl-host}}/detection/v1/interactions</set-url>
                <set-method>POST</set-method>
                <set-header name="Content-Type" exists-action="override">
                    <value>application/json</value>
                </set-header>
                <set-header name="Authorization" exists-action="override">
                    <value>@("Bearer " + (string)context.Variables["access_token"])</value>
                </set-header>
                <set-header name="HL-Project-Id" exists-action="override">
                    <value>@((string)context.Variables["hl_project_id"])</value>
                </set-header>
                <set-header name="X-Correlation-Id" exists-action="override">
                    <value>@((string)context.Variables["correlationId"])</value>
                </set-header>
                <set-body><![CDATA[@{
                    var body = JObject.Parse((string)context.Variables["hl_original_body"]);
                    var messages = body["messages"] ?? new JArray();
                    var v1Body = new JObject {
                        ["metadata"] = new JObject {
                            ["model"] = (string)context.Variables["hl_model"],
                            ["requester_id"] = (string)context.Variables["hl_requester_id"],
                            ["provider"] = (string)context.Variables["hl_provider"]
                        },
                        ["input"] = new JObject {
                            ["messages"] = messages
                        }
                    };
                    return v1Body.ToString();
                }]]></set-body>
            </send-request>
            <set-variable name="hl_input_status_code" value='@(context.Variables.ContainsKey("hl_eval_response") &amp;&amp; context.Variables["hl_eval_response"] != null ? ((IResponse)context.Variables["hl_eval_response"]).StatusCode.ToString() : "null")' />
            <set-variable name="hl_input_duration_ms" value='@((DateTime.UtcNow - (DateTime)context.Variables["hl_input_start"]).TotalMilliseconds)' />
            <choose>
                <when condition='@(context.Variables.ContainsKey("hl_eval_response") &amp;&amp; context.Variables["hl_eval_response"] != null &amp;&amp; ((IResponse)context.Variables["hl_eval_response"]).StatusCode >= 200 &amp;&amp; ((IResponse)context.Variables["hl_eval_response"]).StatusCode &lt; 300)'>
                    <set-variable name="hl_eval_json" value='@(((IResponse)context.Variables["hl_eval_response"]).Body.As&lt;JObject&gt;())' />
                    <set-variable name="hl_runtime_action" value='@((string)(((JObject)context.Variables["hl_eval_json"])["evaluation"]?["action"] ?? ""))' />
                    <set-variable name="hl_threat_level" value='@((string)(((JObject)context.Variables["hl_eval_json"])["evaluation"]?["threat_level"] ?? ""))' />
                    <choose>
                        <when condition='@(((string)context.Variables.GetValueOrDefault("hl_runtime_action", "")).Equals("Block", StringComparison.OrdinalIgnoreCase))'>
                            <!-- Block: Return OpenAI-format block response to client -->
                            <return-response>
                                <set-status code="200" reason="OK" />
                                <set-header name="Content-Type" exists-action="override">
                                    <value>application/json</value>
                                </set-header>
                                <set-header name="HL-Runtime-Action" exists-action="override">
                                    <value>BLOCK</value>
                                </set-header>
                                <set-header name="HL-Interaction-Action" exists-action="override">
                                    <value>@((string)context.Variables.GetValueOrDefault("hl_runtime_action", ""))</value>
                                </set-header>
                                <set-header name="HL-Interaction-Threat-Level" exists-action="override">
                                    <value>@((string)context.Variables.GetValueOrDefault("hl_threat_level", ""))</value>
                                </set-header>
                                <set-body><![CDATA[@{
                                    var evalJson = (JObject)context.Variables["hl_eval_json"];
                                    var threatLevel = (string)(evalJson["evaluation"]?["threat_level"] ?? "unknown");
                                    var blockMsg = $"This request has been blocked by HiddenLayer AI security. Threat level: {threatLevel}";
                                    var resp = new JObject {
                                        ["id"] = "hl-blocked",
                                        ["object"] = "chat.completion",
                                        ["choices"] = new JArray {
                                            new JObject {
                                                ["index"] = 0,
                                                ["message"] = new JObject {
                                                    ["role"] = "assistant",
                                                    ["content"] = blockMsg
                                                },
                                                ["finish_reason"] = "stop"
                                            }
                                        }
                                    };
                                    return resp.ToString();
                                }]]></set-body>
                            </return-response>
                        </when>
                        <when condition='@(((string)context.Variables.GetValueOrDefault("hl_runtime_action", "")).Equals("Redact", StringComparison.OrdinalIgnoreCase))'>
                            <!-- Redact: Merge modified_data.input.messages back into original body -->
                            <set-body><![CDATA[@{
                                var evalJson = (JObject)context.Variables["hl_eval_json"];
                                var redactedMessages = evalJson["modified_data"]?["input"]?["messages"];
                                if (redactedMessages != null) {
                                    var original = JObject.Parse((string)context.Variables["hl_original_body"]);
                                    original["messages"] = redactedMessages;
                                    return original.ToString();
                                }
                                return (string)context.Variables["hl_original_body"];
                            }]]></set-body>
                        </when>
                        <otherwise>
                            <!-- Allow/Alert: Pass original body unchanged -->
                            <set-body>@((string)context.Variables["hl_original_body"])</set-body>
                        </otherwise>
                    </choose>
                </when>
            </choose>
            <!-- Delete HL metadata headers before calling backend -->
            <set-header name="HL-Model" exists-action="delete" />
            <set-header name="HL-Provider" exists-action="delete" />
            <set-header name="HL-Requester-Id" exists-action="delete" />
            <!-- Ensure backend responses are not compressed so outbound body inspection works reliably -->
            <set-header name="Accept-Encoding" exists-action="override">
                <value>identity</value>
            </set-header>
        </otherwise>
    </choose>
</fragment>